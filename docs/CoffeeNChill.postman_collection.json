{
  "info": {
    "name": "CoffeeNChill API",
    "description": "CoffeeNChill Canteen Management System API: Menu Management, Staff Documents, and Asynchronous Order Processing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "category",
      "value": "Beverages",
      "type": "string"
    },
    {
      "key": "itemId",
      "value": "item-001",
      "type": "string"
    },
    {
      "key": "fileName",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Menu",
      "item": [
        {
          "name": "Create Menu Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partitionKey\": \"{{category}}\",\n  \"rowKey\": \"{{itemId}}\",\n  \"name\": \"Cappuccino\",\n  \"description\": \"Espresso with steamed milk foam\",\n  \"price\": 32.5,\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": ["{{baseUrl}}"],
              "path": ["menu"]
            },
            "description": "Creates a new menu item. PartitionKey is the category and RowKey is the item ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response contains the created item', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.rowKey).to.eql(pm.collectionVariables.get('itemId'));",
                  "    pm.expect(json.partitionKey).to.eql(pm.collectionVariables.get('category'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Menu Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": ["{{baseUrl}}"],
              "path": ["menu"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Menu Items By Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu/category/{{category}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "category", "{{category}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All items belong to the requested category', function () {",
                  "    const json = pm.response.json();",
                  "    json.forEach((item) => {",
                  "        pm.expect(item.partitionKey).to.eql(pm.collectionVariables.get('category'));",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Menu Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cappuccino\",\n  \"description\": \"Espresso with steamed milk foam and cocoa dusting\",\n  \"price\": 35.0,\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{category}}/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "{{category}}", "{{itemId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Price was updated', function () {",
                  "    pm.expect(pm.response.json().price).to.eql(35);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Menu Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu/{{category}}/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "{{category}}", "{{itemId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Staff Documents",
      "item": [
        {
          "name": "Upload Staff Document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "upload"]
            },
            "description": "Upload a file using the file form field to the staff-docs Azure File Share."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response contains uploaded file metadata', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.fileName).to.be.a('string');",
                  "    pm.expect(json.sizeInBytes).to.be.greaterThan(-1);",
                  "    pm.collectionVariables.set('fileName', json.fileName);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Staff Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["documents"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array of document metadata', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    if (json.length > 0) {",
                  "        pm.expect(json[0]).to.have.property('fileName');",
                  "        pm.expect(json[0]).to.have.property('sizeInBytes');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Download Staff Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/download/{{fileName}}",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "download", "{{fileName}}"]
            },
            "description": "Run Upload Staff Document first so the fileName variable is populated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Disposition header is present', function () {",
                  "    pm.response.to.have.header('Content-Disposition');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Download Staff Document - Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/download/does-not-exist.pdf",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "download", "does-not-exist.pdf"]
            },
            "description": "Error-handling check. A file that does not exist should return 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Queue New Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"ORD-1005\",\n  \"customerName\": \"Test Customer\",\n  \"selectedItemSKUs\": [\"CAP-001\", \"LAT-001\"],\n  \"totalPrice\": 65.0,\n  \"orderTimestamp\": \"2026-10-12T12:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/queue",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "queue"]
            },
            "description": "Submits a new order to the order-processing-queue for asynchronous processing."
          }
        },
        {
          "name": "Update Order Status - Preparing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Preparing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/2026-10-12/ORD-1005/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "2026-10-12", "ORD-1005", "status"]
            },
            "description": "Run after the queued order has been processed and saved with Received status."
          }
        },
        {
          "name": "Update Order Status - Ready",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Ready\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/2026-10-12/ORD-1005/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "2026-10-12", "ORD-1005", "status"]
            },
            "description": "Run after the order status is Preparing."
          }
        },
        {
          "name": "Update Order Status - Collected",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Collected\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/2026-10-12/ORD-1005/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "2026-10-12", "ORD-1005", "status"]
            },
            "description": "Run after the order status is Ready."
          }
        }
      ]
    }
  ]
}